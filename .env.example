# Copy file nay thanh ".env" TREN EC2 roi dien gia tri that.
#   cp .env.example .env && nano .env
#
# .env DA nam trong .gitignore - tuyet doi khong commit file .env that len Git.

# ---- ECR ----
# Lay bang: aws sts get-caller-identity --query Account --output text
# Dinh dang: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com

# Tag image se deploy. CI/CD nen dat = git commit SHA de rollback duoc.
IMAGE_TAG=latest

# ---- Amazon RDS ----
# Endpoint o tab Connectivity & security cua RDS (KHONG kem :3306)
DB_HOST=energy-tracker.cjicc6s22jz7.ap-southeast-2.rds.amazonaws.com
DB_USERNAME=admin
DB_PASSWORD=doi-thanh-mat-khau-that

# ---- InfluxDB ----
INFLUX_PASSWORD=doi-thanh-mat-khau-manh
INFLUX_TOKEN=doi-thanh-token-ngau-nhien-dai

# ---- Keycloak ----
KEYCLOAK_ADMIN_PASSWORD=doi-thanh-mat-khau-manh

# ---- Grafana (chi dung khi bat profile observability) ----
GRAFANA_ADMIN_PASSWORD=doi-thanh-mat-khau-manh

# ---- Ollama / insight-service ----
# insight-service KHONG deploy tren AWS (dat sau profile "ai" trong compose.prod).
# Chi can bien duoi day neu sau nay bat lai bang Amazon Bedrock hoac Ollama tu host.
# OLLAMA_URL=http://ollama:11434
